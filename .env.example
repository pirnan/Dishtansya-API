APP_NAME="Dishtansya API"
APP_ENV=local
APP_KEY=base64:qJ8+kFj83gUeD4zK8W3X9N3eE8L2Z6P4X9Y0M7K5R1Q=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
